Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o directorio existe, no reescribir.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Funciona tanto en raíz como en una subcarpeta (XAMPP/local).
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Protección de archivos privados y de configuración.
<FilesMatch "^(\.env(?:\..*)?|composer\.(json|lock)|\.gitignore)$">
    Require all denied
</FilesMatch>

# Impide exponer respaldos, volcados o paquetes por HTTP.
<FilesMatch "\.(?:sql|zip|log|bak|old|tmp)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
