# Entorno: local | qa | production
APP_ENV=local
APP_URL=http://localhost/entrevecinos
# Use / para raíz o /entrevecinos para XAMPP en subcarpeta.
EV_BASE_URL=/entrevecinos

# Zona horaria oficial de la aplicación y sesión MySQL (Perú)
EV_APP_TIMEZONE=America/Lima
EV_DB_TIME_ZONE=-05:00

BD_SERVIDOR=127.0.0.1
BD_PUERTO=3306
BD_USUARIO=usuario_ev
BD_PASSWORD=CAMBIAR_EN_CADA_ENTORNO
BD_CLAVE=
BD_NOMBRE=entrevecinos_local
BD_NOMBRE_BD=entrevecinos_local

JWT_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_LARGO_Y_UNICO
JWT_EXPIRATION_SECONDS=3600

# local | produccion | auto
EV_ENTORNO=local
